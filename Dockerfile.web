FROM node:22-alpine AS builder

WORKDIR /src
COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY content-server ./content-server
COPY tsconfig.base.json ./

RUN npm ci

ARG APP=phone
ARG APP_VERSION=0.1.0
ARG GIT_SHA=unknown
ARG VITE_RELAY_BASE=https://beta-play.aircanvas.kr
ARG VITE_CONTENT_BASE=https://beta.aircanvas.kr/content
ENV VITE_RELAY_BASE=${VITE_RELAY_BASE}
ENV VITE_CONTENT_BASE=${VITE_CONTENT_BASE}

RUN mkdir -p "apps/${APP}/public" \
    && printf '{"service":"aircanvas-%s","version":"%s","git_sha":"%s"}\n' "${APP}" "${APP_VERSION}" "${GIT_SHA}" > "apps/${APP}/public/version.json" \
    && npm run build:protocol \
    && npm run build:art \
    && npm run build -w "apps/${APP}"

FROM nginx:1.27-alpine AS runtime

ARG APP=phone
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/apps/${APP}/dist /usr/share/nginx/html
COPY --from=builder /src/content-server /usr/share/nginx/html/content

EXPOSE 80
