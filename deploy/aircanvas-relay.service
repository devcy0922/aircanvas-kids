[Unit]
Description=AirCanvas Kids Rust 릴레이 서버
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/company/prd/kids/aircanvas-kids
ExecStart=/srv/company/prd/kids/aircanvas-kids/server/target/release/aircanvas-relay
Environment=HT_BIND=0.0.0.0:8180
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
